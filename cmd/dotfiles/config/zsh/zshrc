# ── vitualizz dotfiles ─────────────────────────────────────────────
# Bloque sembrado por github.com/vitualizz/dotfiles. Desde ahora es tuyo:
# edítalo, muévelo o bórralo; el instalador no lo vuelve a tocar.
# Cada sección solo actúa si eso todavía no está configurado arriba.

if [[ -z "$HOMEBREW_PREFIX" ]]; then
  for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    if [[ -x "$_brew" ]]; then
      eval "$("$_brew" shellenv zsh)"
      break
    fi
  done
  unset _brew
fi

if [[ -z "$ANDROID_HOME" ]]; then
  if [[ "$OSTYPE" == darwin* ]]; then
    export ANDROID_HOME="$HOME/Library/Android/sdk"
  else
    export ANDROID_HOME="$HOME/Android/Sdk"
  fi
fi
export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"

for _dir in "$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/.local/share/mise/shims" "$HOME/.opencode/bin" "$BUN_INSTALL/bin" /opt/pgsql-16/bin; do
  [[ -d "$_dir" && ${path[(Ie)$_dir]} -eq 0 ]] && path=("$_dir" $path)
done
for _dir in "$ANDROID_HOME/emulator" "$ANDROID_HOME/platform-tools" "$ANDROID_HOME/cmdline-tools/latest/bin" "$HOME/.turso"; do
  [[ -d "$_dir" && ${path[(Ie)$_dir]} -eq 0 ]] && path+=("$_dir")
done
unset _dir

if [[ "$OSTYPE" == linux* && -z "$SSH_AUTH_SOCK" && -S "$XDG_RUNTIME_DIR/ssh-agent.socket" ]]; then
  export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
fi

if [[ -z "$HISTFILE" ]]; then
  HISTFILE="$HOME/.zsh_history"
  HISTSIZE=50000
  SAVEHIST=50000
  setopt share_history hist_ignore_all_dups
fi

(( ${+functions[compdef]} )) || { autoload -Uz compinit && compinit; }

if (( ! ${+aliases[gst]} )) && [[ -r "$HOME/.zsh/plugins/omz-git/git.plugin.zsh" ]]; then
  (( ${+functions[git_current_branch]} )) || git_current_branch() { git branch --show-current 2>/dev/null; }
  source "$HOME/.zsh/plugins/omz-git/git.plugin.zsh"
fi

if (( ! ${+aliases[vim]} )) && command -v nvim >/dev/null; then
  alias vim="nvim"
fi

if command -v starship >/dev/null && [[ -z "$STARSHIP_SHELL" && -z "$ZSH_THEME" ]] && (( ! ${+functions[p10k]} )); then
  eval "$(starship init zsh)"
fi
if command -v zoxide >/dev/null && (( ! ${+functions[__zoxide_z]} )); then
  eval "$(zoxide init zsh)"
fi
if command -v direnv >/dev/null && (( ! ${+functions[_direnv_hook]} )); then
  eval "$(direnv hook zsh)"
fi
if command -v fzf >/dev/null && (( ! ${+functions[fzf-history-widget]} )); then
  source <(fzf --zsh 2>/dev/null)
fi
if command -v atuin >/dev/null && [[ -z "$ATUIN_SESSION" ]]; then
  eval "$(atuin init zsh)"
fi

if (( ! ${+functions[_zsh_autosuggest_start]} )) && [[ -r "$HOME/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$HOME/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi
if [[ -z "$ZSH_HIGHLIGHT_VERSION" && -r "$HOME/.zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$HOME/.zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# ── fin vitualizz dotfiles ─────────────────────────────────────────
