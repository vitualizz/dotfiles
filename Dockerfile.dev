FROM golang:1.24-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    git bash curl wget zsh sudo \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

CMD ["bash", "-c", "go build -buildvcs=false -o /tmp/dotfiles ./cmd/dotfiles/ && /tmp/dotfiles --ci"]
